{
  "name": "Deal Board",
  "short_name": "Deals",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#18191C",
  "theme_color": "#18191C",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/plain",
            ".txt",
            "application/zip",
            ".zip"
          ]
        }
      ]
    }
  }
}